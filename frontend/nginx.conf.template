# nginx serves the built SPA and reverse-proxies /api to the backend so the browser
# makes same-origin requests and the aida_session cookie stays same-site (what Vite's
# dev proxy does in development). ${API_PROXY_TARGET} is substituted from the environment
# at container start by nginx's /etc/nginx/templates mechanism — nginx runtime variables
# ($uri, $host, ...) are left untouched because they are not environment variables.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_PROXY_TARGET};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Client-side routing: unknown paths fall back to the SPA entry point.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
