# Production backend image: compiles TypeScript in a builder, then ships only the
# compiled JS + runtime deps on a minimal Alpine node. No tsx/typescript/vitest and
# no npm in the final image, so the dev-tooling CVE surface never reaches production.

FROM node:25-alpine AS build
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json* ./
RUN npm ci
# tsc rootDir is the repo root, so the layout under /app must mirror the source tree:
# backend/src + shared/src compile to dist/backend/src + dist/shared/src.
COPY backend/src ./src
COPY backend/tsconfig.json ./
COPY tsconfig.base.json /app/tsconfig.base.json
COPY shared/src /app/shared/src
RUN npm run build

FROM node:25-alpine AS runtime
# Patch OS packages (openssl/libssl3/libcrypto3) beyond the base image's snapshot.
RUN apk --no-cache upgrade
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json* ./
# Runtime deps only, then delete npm itself — its bundled tar/sigstore/ip-address are
# the only reason those packages would show up in a scan, and node runs the app directly.
RUN npm ci --omit=dev \
  && npm cache clean --force \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=build /app/backend/dist ./dist
# migration-files.js resolves migrations at dist/database/migrations (../../ from dist/backend/src).
COPY database/migrations ./dist/database/migrations

ENV NODE_ENV=production \
    PORT=3000
EXPOSE 3000
USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Migrations and the admin seed run before the API, same as dev — but from compiled JS.
CMD ["sh", "-c", "node dist/backend/src/migrate.js && node dist/backend/src/seed-admin.js && node dist/backend/src/server.js"]
