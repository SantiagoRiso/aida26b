{
  "name": "professional-agenda-backend",
  "version": "1.0.0",
  "description": "Backend for the professional agenda and appointment scheduling system",
  "main": "dist/backend/src/server.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/backend/src/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "seed-admin": "tsx src/seed-admin.ts",
    "seed:foundation": "tsx src/seed-foundation.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "seed:demo:reset": "tsx src/seed-demo.ts --reset",
    "test": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:db:coverage": "vitest run --config vitest.db.config.mts --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.5",
    "@types/pg": "^8.10.2",
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.22.3",
    "typescript": "^5.1.6",
    "vitest": "^4.1.9"
  }
}
