# Example environment variables for running docker-compose
# Copy to .env and edit values before running compose

# Docker / app
NODE_ENV=development
PORT=3000
# Version reported in every log line. Dejalo vacío salvo que quieras fijar el tag de una imagen
# publicada: sin valor, el backend toma la versión de backend/package.json y no hay dos copias
# que se puedan desincronizar.
# VERSION=

# Nivel mínimo que se emite: debug | info | warn | error | silent
LOG_LEVEL=info

# Retención de los logs de contenedor (driver json-file de Docker). Cada servicio guarda como
# máximo LOG_MAX_FILE archivos de LOG_MAX_SIZE cada uno; al llenarse rota y descarta el más viejo.
# Con los valores por defecto son 50 MB por servicio como techo en disco.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# Database used by the app (postgres service)
DB_HOST=database
DB_PORT=5432
DB_NAME=professional_agenda
DB_USER=aida26_user
DB_PASSWORD=CambiaEsta!

# Schema owner / migration role: migrations and bootstrap seeds run as this role. It reuses
# DB_HOST/DB_PORT/DB_NAME. Required — migrate/seed fail fast if unset (no fallback to DB_USER).
DB_OWNER_USER=aida26_owner
DB_OWNER_PASSWORD=CambiaEsta_Owner!

# Cluster superuser, container bootstrap only. No POSTGRES_DB on purpose: the app database is
# created by bootstrap.sh (owned by DB_OWNER_USER) from the DB_* vars above, not by the image.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=CambiaEsta_Super!

# backend/test/helpers.ts: name of the throwaway database the DB test suite (`npm run test:db`)
# drops/recreates on every run. Optional — defaults to professional_agenda_test. Only set this to
# something unique when running the suite concurrently with another run against the same Postgres
# (parallel agents, parallel CI jobs) so they don't drop each other's database mid-run.
# TEST_DB_NAME=professional_agenda_test

# Hot reload of the backend container. Bind mounts from a Windows/macOS host deliver no
# filesystem events to the container, so tsx watch has to poll to see an edit. Raise the interval
# (milliseconds) if the polling costs too much CPU; set USEPOLLING=false on a Linux host.
# CHOKIDAR_USEPOLLING=true
# CHOKIDAR_INTERVAL=300

ADMIN_USERNAME=admin
ADMIN_PASSWORD=yourpassword
ADMIN_EMAIL=admin@example.com

BUSINESS_NAME=Default Business
