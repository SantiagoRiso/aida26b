# Example environment variables for running docker-compose
# Copy to .env and edit values before running compose

# Docker / app
NODE_ENV=development
PORT=3000

# Database used by the app (postgres service)
DB_HOST=database
DB_PORT=5432
DB_NAME=faculty_management
DB_USER=aida26_user
DB_PASSWORD=CambiaEsta!

# Schema owner: migrations run as this role. Same database as DB_* above; only
# the credentials differ. Leave unset to migrate as DB_USER.
DB_OWNER_USER=aida26_owner
DB_OWNER_PASSWORD=CambiaEsta_Owner!

# Cluster superuser, container bootstrap only. No POSTGRES_DB on purpose: the app
# database is created by bootstrap.sql owned by aida26_owner, not by the image.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=CambiaEsta_Super!
